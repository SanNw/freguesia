# =============================================================================
# Caddyfile — Produção
# Substituir n8n.example.com e worker.example.com pelos domínios reais
# =============================================================================

n8n.example.com {
	reverse_proxy n8n:5678 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

worker.example.com {
	reverse_proxy worker:3001 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
