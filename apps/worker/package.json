{
  "name": "@freguesia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Freguesia Worker - API interna, adaptadores de fontes e automacao com Playwright",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "auth:mercadolivre": "tsx src/adapters/browser/auth-mercadolivre.ts",
    "db:migrate": "tsx src/adapters/persistence/migrate.ts",
    "db:seed": "tsx src/adapters/persistence/seed.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "zod": "^3.24.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.49.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "prettier": "^3.4.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0"
  },
  "engines": {
    "node": ">=22"
  }
}
