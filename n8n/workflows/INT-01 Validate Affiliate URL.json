{
  "name": "INT-01 Validate Affiliate URL",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{.urls.affiliate}}",
        "options": {
          "allowRedirect": false
        }
      },
      "name": "Check Affiliate URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{[\"Check Affiliate URL\"].json.headers.location}}",
              "operation": "contains",
              "value2": "={{.urls.canonical}}"
            }
          ]
        }
      },
      "name": "Check Redirect",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Check Affiliate URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Affiliate URL": {
      "main": [
        [
          {
            "node": "Check Redirect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
