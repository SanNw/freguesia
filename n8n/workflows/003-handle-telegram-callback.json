{
  "id": "5fcb552b-c6c6-41d5-b9ef-bde2ce642aef",
  "name": "WF-003 - Callback Telegram",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "freguesia/callback",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WORKER_INTERNAL_BASE_URL }}/v1/telegram/callback",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WORKER_SERVICE_TOKEN }}"
            },
            {
              "name": "X-Telegram-Bot-Api-Secret-Token",
              "value": "={{ $json.headers['x-telegram-bot-api-secret-token'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyJson": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "call-worker",
      "name": "Call Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body) }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Worker": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
