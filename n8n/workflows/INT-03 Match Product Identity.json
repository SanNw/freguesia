{
  "name": "INT-03 Match Product Identity",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{.WORKER_INTERNAL_BASE_URL}}/v1/products/{{.productId}}/matches",
        "authentication": "bearerToken",
        "nodeCredentialType": "n8n-nodes-base.bearerToken"
      },
      "name": "Find Matches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        470,
        300
      ],
      "credentials": {
        "bearerToken": {
          "id": "={{.INTERNAL_API_TOKEN_ID}}",
          "name": "Internal API Token"
        }
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Find Matches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
